# GoDaddy Production Environment Configuration
NODE_ENV=production
PORT=3000

# GoDaddy MySQL Database Connection
# NOTE: 
# - If your Node.js app runs on the SAME GoDaddy cPanel hosting account as your MySQL database:
#   Use: MYSQL_HOST=localhost (prevents ETIMEDOUT loopback firewall blocks)
# - If connecting from outside GoDaddy (e.g. AI Studio preview, external VPS, or local PC):
#   Use: MYSQL_HOST=118.139.180.163
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=khema_dbuser
MYSQL_PASSWORD=Y+k,C=JAEA4nR+0*
MYSQL_DATABASE=khema_ainotes
MYSQL_SSL=false
PRIMARY_DB=godaddy
PRIMARY_LOCKED=true

# Security & Authentication
JWT_SECRET=super-secret-key-change-in-prod

# Gemini AI (Optional - for Mail Assistant Smart Replies & Summaries)
GEMINI_API_KEY=your_gemini_api_key

# Telegram Disconnection Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id