# GoDaddy Production Environment Configuration
NODE_ENV=production
PORT=3000

# GoDaddy / MySQL Database Connection
# Standard aliases supported: DB_* and MYSQL_*
DB_HOST=localhost
DB_PORT=3306
DB_USER=khema_dbuser
DB_PASSWORD=your_mysql_password
DB_NAME=khema_ainotes

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=khema_dbuser
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=khema_ainotes
MYSQL_SSL=false
PRIMARY_DB=godaddy
PRIMARY_LOCKED=true

# Security & Authentication
JWT_SECRET=super-secret-key-change-in-prod

# Gemini AI (Optional - for Mail Assistant Smart Replies & Summaries)
GEMINI_API_KEY=your_gemini_api_key

# Telegram Disconnection Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id